{
  "name": "baopin-selection-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e:preflight": "node ./scripts/check-e2e-env.mjs",
    "test:e2e:smoke": "playwright test e2e/smoke-flow.spec.mjs --browser=chromium",
    "test:e2e": "playwright test --browser=chromium",
    "test:e2e:ci": "npm run test:e2e:preflight && npm run build && playwright test --browser=chromium"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.6"
  }
}
